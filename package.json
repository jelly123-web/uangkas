{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "concurrently \"npm run dev:local --prefix frontend\" \"npm run dev:local --prefix backend\"",
        "dev": "npm run start",
        "frontend": "npm run dev --prefix frontend",
        "backend": "npm run dev --prefix backend",
        "build": "npm run build --prefix frontend"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
